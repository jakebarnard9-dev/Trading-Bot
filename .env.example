############################################################################################
#  >>>  YOUR ANTHROPIC API KEY GOES ON THE NEXT LINE, RIGHT AFTER THE = SIGN  <<<
#  Example:  ANTHROPIC_API_KEY=sk-ant-api03-abc123...   (no spaces, no quotes)
#  Get it at console.anthropic.com -> API Keys -> Create Key.  Required for the analyst,
#  researcher, risk officer and ops agents; without it the bot trades on quant signals only.
############################################################################################
ANTHROPIC_API_KEY=

# ---- Broker credentials (only the one you select in config.yaml `broker:`)
# IBKR: no keys here; the bot connects to TWS / IB Gateway on ibkr.host:ibkr.port (see README).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ---- Optional data sources (each one adds a redundant feed; all have free tiers)
FMP_API_KEY=
FINNHUB_API_KEY=
TAVILY_API_KEY=

# ---- Notifications (optional but strongly recommended)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ---- Safety interlock for live trading. The bot refuses to place real orders unless this is exactly "I_UNDERSTAND_THE_RISK".
LIVE_TRADING_ACK=

# ============================================================================================================
# ---- IB Gateway (docker-compose.cloud.yml only) -------------------------------------------------------------
# Read by the headless gateway container (ghcr.io/gnzsnz/ib-gateway) that docker-compose.cloud.yml starts next
# to the bot. Ignored by `earnings-bot` itself and by docker-compose.yml. Variable names follow the image's README
# (https://github.com/gnzsnz/ib-gateway-docker, verified 2026-11-08). Never commit real values.
# ============================================================================================================
# IBKR username/password the gateway logs in with. Second factor must be the IBKR Mobile app (IB Key): every full
# login sends a push notification you approve on your phone (first start, and every Sunday night).
TWS_USERID=
TWS_PASSWORD=
# live = the real account; paper = your paper-trading username/password (dry run). The bot's port must match:
#   TRADING_MODE=live  -> IBKR_PORT=4003        TRADING_MODE=paper -> IBKR_PORT=4004
# (IBKR_HOST / IBKR_PORT override config.yaml ibkr.host / ibkr.port; the compose file sets IBKR_HOST=ib-gateway.)
TRADING_MODE=live
IBKR_PORT=4003
# Password of the gateway's VNC screen. Empty = VNC off. Bound to 127.0.0.1 on the VPS; reach it via SSH tunnel.
VNC_SERVER_PASSWORD=
# Daily restart that re-uses the session (no new login). Format hh:mm AM/PM in TIME_ZONE. IBKR expires the session
# every Sunday, so the Sunday restart is a full login that needs an IB Key approval.
AUTO_RESTART_TIME=11:45 PM
TIME_ZONE=America/New_York
# If the IB Key push is not approved within IBKR's ~3-minute window: restart = start the login again (new push) and
# keep doing so until approved (right for a headless box); exit = stop the container (Docker restarts it; slower).
TWOFA_TIMEOUT_ACTION=restart
RELOGIN_AFTER_TWOFA_TIMEOUT=yes
TWOFA_EXIT_INTERVAL=60
TWOFA_DEVICE=
# API settings IBC applies on every start. The bot needs all three: place orders (READ_ONLY_API=no), connect without
# an "accept incoming connection?" dialog (TWS_ACCEPT_INCOMING=accept), no order-precaution pop-ups (BYPASS_WARNING=yes).
READ_ONLY_API=no
TWS_ACCEPT_INCOMING=accept
BYPASS_WARNING=yes
# primary = this gateway takes over if the same username is logged in elsewhere (and vice versa: do not use the same
# username in TWS on your desktop while it runs).
EXISTING_SESSION_DETECTED_ACTION=primary
ALLOW_BLIND_TRADING=no
# Optional: Java heap in MB (default 768); persistent gateway settings dir (needs a volume, see DEPLOY_CLOUD.md).
JAVA_HEAP_SIZE=
TWS_SETTINGS_PATH=
